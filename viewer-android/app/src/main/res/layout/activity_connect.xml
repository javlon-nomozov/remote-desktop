<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ulanish"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Internet orqali (kod) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Internet orqali: kompyuterdagi kodni kiriting"
            android:textColor="#888888" />

        <EditText
            android:id="@+id/code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:hint="Ulanish kodi (masalan 103 727 327)"
            android:inputType="number"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Ulanish" />

        <!-- Lokal tarmoq (Wi-Fi / USB) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="18dp"
            android:background="#33888888" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lokal tarmoq (Wi-Fi yoki USB)"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lanStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Telefon va kompyuter bitta Wi-Fi'da bo'lsin. USB orqali: kabelni ulang va telefonda Sozlamalar → Ulanishlar → Mobil hotspot va modem → USB modem ni yoqing. Internet shart emas."
            android:textColor="#888888"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnLogout"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Chiqish"
            android:textColor="#888888" />
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.remoteviewer.app.RemoteView
        android:id="@+id/remoteView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Boshqaruv paneli (ustki o'ng burchak) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:orientation="horizontal"
        android:padding="6dp"
        android:background="#66000000">

        <Button
            android:id="@+id/btnMode"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Touch" />

        <Button
            android:id="@+id/btnKeyboard"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⌨" />

        <Button
            android:id="@+id/btnScreenshot"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📷" />

        <Button
            android:id="@+id/btnDisconnect"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕" />
    </LinearLayout>

    <!-- Kompyuter tugmalari (⌨ bosilganda ko'rinadi): Esc, Tab, Ctrl, Alt, Shift, Win, strelkalar,
         F1-F12... Tugmalar ViewerActivity'da yaratiladi. Tepada — ekran klaviaturasi uni yopmaydi. -->
    <HorizontalScrollView
        android:id="@+id/keysBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="60dp"
        android:background="#88000000"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/keysRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp" />
    </HorizontalScrollView>

    <!-- Touchpad tugmalari (faqat touchpad rejimida ko'rinadi): Chap · GYRO · O'ng -->
    <LinearLayout
        android:id="@+id/touchpadBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:background="#88000000"
        android:padding="6dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnLeft"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Chap" />

        <Button
            android:id="@+id/btnGyro"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="GYRO" />

        <Button
            android:id="@+id/btnRight"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="O'ng" />
    </LinearLayout>

    <!-- Klaviatura kiritishini ushlash uchun ko'rinmas maydon -->
    <EditText
        android:id="@+id/hiddenInput"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:alpha="0"
        android:inputType="textNoSuggestions"
        android:importantForAutofill="no" />
</FrameLayout>

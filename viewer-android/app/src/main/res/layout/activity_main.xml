<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Remote Viewer"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kod orqali ulanish"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/relayUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Server manzili (ws://... yoki wss://...)"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ulanish kodi (masalan 103 727 327)"
            android:inputType="number"
            android:layout_marginTop="6dp" />

        <EditText
            android:id="@+id/token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Kirish kodi (botда /kirish)"
            android:inputType="textPassword"
            android:layout_marginTop="6dp" />

        <Button
            android:id="@+id/btnCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ulanish (kod)"
            android:layout_marginTop="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33000000"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yoki bir tarmoqda (LAN, IP)"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Server IP (masalan 192.168.1.50)"
            android:inputType="text" />

        <EditText
            android:id="@+id/port"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Port"
            android:inputType="number"
            android:text="8765"
            android:layout_marginTop="6dp" />

        <Button
            android:id="@+id/btnLan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ulanish (LAN)"
            android:layout_marginTop="12dp" />
    </LinearLayout>
</ScrollView>

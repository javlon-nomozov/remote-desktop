# Namuna. Shu faylni `.env` deb nusxalang va qiymatlarni to'ldiring.
# MUHIM: o'zgaruvchi NOMLARI aynan shunday bo'lsin (config shu nomlarni kutadi).

# --- Telegram bot ---
BOT_TOKEN=123456789:AA...bot-tokeningiz
# admin(lar) telegram user id, vergul bilan: 12345678,99999999
ADMIN_IDS=12345678

# --- Ma'lumotlar bazasi ---
# Lokal test uchun sqlite yetarli. Railway'da DATABASE_URL avtomatik beriladi.
DATABASE_URL=sqlite:///./remote.db

# --- Admin panel (SQLAdmin) login ---
ADMIN_PANEL_USER=admin
ADMIN_PANEL_PASSWORD=parolni-ozgartiring
ADMIN_SESSION_SECRET=tasodifiy-uzun-maxfiy-satr

# --- Public URL ---
# Railway service URL (oxirida / yo'q). Lokalda quyidagicha:
PUBLIC_BASE_URL=http://localhost:8000
